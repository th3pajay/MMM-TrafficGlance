{
    module: "MMM-TrafficGlance",
    position: "bottom_center",
    header: "Traffic Glance",
    config: {
        apiKey: "YOUR_TOMTOM_API_KEY_HERE",
        routes: [
            { id: "to-work", name: "Work", origin: "48.8584,2.2945", destination: "48.8606,2.3376" },
            { id: "to-home", name: "Home", origin: "48.8606,2.3376", destination: "48.8584,2.2945" }
        ],

        refreshMinutes: 5,        // floor; polling auto-slows to fit monthlyQuota
        monthlyQuota: 20000,      // your Routing API calls per month; 0 = poll exactly every refreshMinutes
        width: 350,               // px, 0 = no limit

        map: "leaflet",           // "leaflet" | "leaflet-fr" | "leaflet-tomtom" | "svg" | false
        mapHeight: 220,           // px
        sparkline: true,          // true | false | "curved" | "stepped"
        incidents: true,          // true | false | ["JAM", "ROAD_WORK", "ROAD_CLOSURE", "OTHER"]

        showDelta: true,          // "+2m" vs historical average
        showTrend: true,          // up/down/stable arrow
        warnAt: 10,               // % slower than usual -> yellow
        criticalAt: 25            // % slower than usual -> red

        // advanced: {            // optional, same names as the internal config; overrides everything above
        //     api: { routeType: "fastest", travelMode: "car", avoid: [], timeout: 10000 },
        //     map: { zoom: null, center: null, padding: [20, 20], zoomControlSize: 22, showScale: true },
        //     sparkline: { width: 160, height: 40, maxDataPoints: 50, lookbackHours: 48, colors: { good: "#2ecc71" } }
        // }
    }
}
